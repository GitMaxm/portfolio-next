{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "lint:fsd": "steiger ./src",
    "fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint && npm run lint:fsd",
    "json-server": "json-server mock/projectsTestTable.json --port 3001",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "sweetalert2": "11.26.25"
  },
  "devDependencies": {
    "@types/node": "24.10.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "json-server": "1.0.0-beta.15",
    "lint-staged": "16.2.7",
    "sass": "1.103.1",
    "steiger": "0.6.0",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  }
}
